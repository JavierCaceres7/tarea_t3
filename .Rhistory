# =============================================================================
# PARTE B — ENE: Pregunta propia sobre el mercado laboral
# =============================================================================
# Pregunta B1-B2: ¿Se asocia el nivel educacional con la probabilidad de ser
# informal, y cuánto de esa asociación se mantiene al controlar por categoría
# ocupacional y región en los ocupados de la ENE (junio 2026)?
ene <- read.csv2("data/raw/ene-2026-06-mjj.csv")
regiones <- c("Tarapacá", "Antofagasta", "Atacama", "Coquimbo", "Valparaíso",
"O'Higgins", "Maule", "Biobío", "La Araucanía", "Los Lagos",
"Aysén", "Magallanes", "Metropolitana", "Los Ríos",
"Arica y Parinacota", "Ñuble")
ocupados <- ene |>
filter(activ == 1) |>
mutate(
informal   = ocup_form == 2,
mujer      = sexo == 2,
# Limpieza de centinela en nivel educacional (ej. CINE 9 = sin clasificación a NA o agrupar)
educ_anos  = na_if(cine11_1d, 9),
categoria  = case_when(
categoria_ocupacion == 1      ~ "Empleador",
categoria_ocupacion == 2      ~ "Cuenta propia",
categoria_ocupacion == 3      ~ "Asalariado privado",
categoria_ocupacion == 4      ~ "Asalariado público",
categoria_ocupacion %in% 5:6  ~ "Servicio doméstico",
categoria_ocupacion == 7      ~ "Familiar no remunerado"),
region_txt = regiones[region]
) |>
select(informal, mujer, edad, categoria, region_txt, fact_cal)
# B3. Dos modelos ponderados con al menos dos controles (uno nuevo: categoría)
ebase <- lm(informal ~ mujer + edad, data = ocupados, weights = fact_cal)
econtroles <- lm(informal ~ mujer + edad + categoria, data = ocupados, weights = fact_cal)
# B4. Extracción y comparación con broom + dplyr
bind_rows(modelo_base = tidy(ebase), modelo_controles = tidy(econtroles), .id = "especificacion") |>
filter(term != "(Intercept)") |>
select(especificacion, term, estimate, std.error, p.value)
lapply(list(base = ebase, con_controles = econtroles), glance) |>
bind_rows(.id = "modelo") |>
select(modelo, r.squared, nobs)
# B5. Análisis de sensibilidad (con y sin ponderación en el modelo base)
ebase_sin_ponderar <- lm(informal ~ mujer + edad, data = ocupados)
bind_rows(ponderado = tidy(ebase), sin_ponderar = tidy(ebase_sin_ponderar), .id = "tipo") |>
filter(term == "mujerTRUE") |>
select(tipo, estimate, std.error)
# C1. Tabla comparativa lado a lado con modelsummary
modelsummary(
list("Modelo Base" = ebase, "Con Controles" = econtroles),
stars   = TRUE,
gof_map = c("nobs", "r.squared")
)
View(econtroles)
View(ebase_sin_ponderar)
View(ebase)
# =============================================================================
# PARTE B — ENE: Pregunta propia sobre el mercado laboral
# =============================================================================
ene <- read.csv2("data/raw/ene-2026-06-mjj.csv")
regiones <- c("Tarapacá", "Antofagasta", "Atacama", "Coquimbo", "Valparaíso",
"O'Higgins", "Maule", "Biobío", "La Araucanía", "Los Lagos",
"Aysén", "Magallanes", "Metropolitana", "Los Ríos",
"Arica y Parinacota", "Ñuble")
# B2. Prepara la base (filtrar ocupados, limpiar centinelas y crear variables)
ocupados <- ene |>
filter(activ == 1) |>                               # solo ocupados
mutate(
informal   = ocup_form == 2,                      # Lógica TRUE / FALSE
mujer      = sexo == 2,
educ_anos  = na_if(cine11_1d, 9),                 # Limpiar centinela 9 (sin clasificación)
region_txt = regiones[region]
) |>
select(informal, mujer, edad, educ_anos, region_txt, fact_cal)
# B3. Dos modelos ponderados con weights = fact_cal (Modelo base y con controles)
e_base     <- lm(informal ~ educ_anos, data = ocupados, weights = fact_cal)
e_controles <- lm(informal ~ educ_anos + mujer + edad, data = ocupados, weights = fact_cal)
# B4. Extraer y comparar con broom + dplyr
# 1. Tabla apilada de coeficientes de la variable de interés (educ_anos)
bind_rows(base = tidy(e_base), controles = tidy(e_controles), .id = "modelo") |>
filter(term == "educ_anos") |>
select(modelo, term, estimate, std.error, p.value)
# 2. glance() apilados de ambos modelos
lapply(list(base = e_base, con_controles = e_controles), glance) |>
bind_rows(.id = "modelo") |>
select(modelo, r.squared, nobs)
# 3. Regresión por grupo (por región) usando group_by() + group_modify() + tidy() con IC
brecha_region <- ocupados |>
group_by(region_txt) |>
group_modify(~ tidy(lm(informal ~ educ_anos + mujer + edad, data = .x, weights = fact_cal),
conf.int = TRUE)) |>
filter(term == "educ_anos") |>
ungroup() |>
select(region_txt, estimate, std.error, conf.low, conf.high, p.value)
brecha_region
# B5. Análisis de sensibilidad (comparar el modelo con controles con y sin ponderación)
e_sin_ponderar <- lm(informal ~ educ_anos + mujer + edad, data = ocupados)
bind_rows(ponderado = tidy(e_controles), sin_ponderar = tidy(e_sin_ponderar), .id = "tipo") |>
filter(term == "educ_anos") |>
select(tipo, estimate, std.error)
